FLASK_ENV=production

# 아래 값은 반드시 강한 값으로 바꿔 주세요.
# 생성 예시: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-secret-key

SITE_TITLE=Watermelon Personal Site
OWNER_NAME=재훈
CONTACT_EMAIL=

POSTGRES_USER=watermelon
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_DB=watermelon_db
POSTGRES_PORT=5432
POSTGRES_HOST=db
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

SESSION_COOKIE_SECURE=1

INSTANCE_HOST_PATH=/mnt/user/appdata/watermelon-personal/data/instance
UPLOADS_HOST_PATH=/mnt/user/appdata/watermelon-personal/data/uploads
POSTGRES_HOST_PATH=/mnt/user/appdata/watermelon-personal/data/postgres
